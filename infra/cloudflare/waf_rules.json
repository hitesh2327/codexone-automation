{
  "description": "Cloudflare WAF Rate Limiting and Security Rules for CodexOne",
  "rules": [
    {
      "description": "Exempt Razorpay Webhook from interactive challenges to prevent dropped renewals",
      "expression": "(http.request.uri.path eq \"/api/subscription/razorpay/webhook\" and http.request.method eq \"POST\")",
      "action": "skip",
      "action_parameters": {
        "ruleset": "current"
      }
    },
    {
      "description": "Protect /api/auth/login from brute force and credential stuffing",
      "expression": "(http.request.uri.path eq \"/api/auth/login\" and http.request.method eq \"POST\")",
      "action": "managed_challenge",
      "ratelimit": {
        "characteristics": ["ip.src"],
        "period": 60,
        "requests_per_period": 10,
        "mitigation_timeout": 600
      }
    },
    {
      "description": "Protect /api/auth/password/forgot from email flooding",
      "expression": "(http.request.uri.path eq \"/api/auth/password/forgot\" and http.request.method eq \"POST\")",
      "action": "managed_challenge",
      "ratelimit": {
        "characteristics": ["ip.src"],
        "period": 60,
        "requests_per_period": 8,
        "mitigation_timeout": 600
      }
    },
    {
      "description": "Protect /api/subscription/checkout from automated card testing and session exhaustion",
      "expression": "(http.request.uri.path eq \"/api/subscription/checkout\" and http.request.method eq \"POST\")",
      "action": "managed_challenge",
      "ratelimit": {
        "characteristics": ["ip.src"],
        "period": 60,
        "requests_per_period": 5,
        "mitigation_timeout": 300
      }
    },
    {
      "description": "Protect /api/subscription/quote from quote calculation spam",
      "expression": "(http.request.uri.path eq \"/api/subscription/quote\" and http.request.method eq \"POST\")",
      "action": "managed_challenge",
      "ratelimit": {
        "characteristics": ["ip.src"],
        "period": 60,
        "requests_per_period": 12,
        "mitigation_timeout": 180
      }
    },
    {
      "description": "Protect /api/auth/signup from mass registration and credential generation",
      "expression": "(http.request.uri.path eq \"/api/auth/signup\" and http.request.method eq \"POST\")",
      "action": "managed_challenge",
      "ratelimit": {
        "characteristics": ["ip.src"],
        "period": 60,
        "requests_per_period": 5,
        "mitigation_timeout": 600
      }
    },
    {
      "description": "Protect /api/auth/password/reset from token brute-forcing",
      "expression": "(http.request.uri.path eq \"/api/auth/password/reset\" and http.request.method eq \"POST\")",
      "action": "managed_challenge",
      "ratelimit": {
        "characteristics": ["ip.src"],
        "period": 60,
        "requests_per_period": 6,
        "mitigation_timeout": 600
      }
    },
    {
      "description": "Protect /api/generate from job dispatch flood and runner exhaustion",
      "expression": "(http.request.uri.path eq \"/api/generate\" and http.request.method eq \"POST\")",
      "action": "managed_challenge",
      "ratelimit": {
        "characteristics": ["ip.src"],
        "period": 60,
        "requests_per_period": 10,
        "mitigation_timeout": 300
      }
    }
  ]
}
