{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "api.app.main:app", "--port", "8000", "--reload", "--reload-dir", "api", "--reload-dir", "src"],
      "env": { "DATABASE_URL": "postgresql+psycopg://codexone:codexone@localhost:5433/codexone" },
      "port": 8000
